# leap: keep __symbols__ in the techpack overlays. The kernel only passes -@ to base DTBs (scripts/Makefile.lib:380);
# without symbols the merged base cannot resolve the stock leap board overlays (cam_cci0, adsp_loader, lpass_*) in ABL.
DTC_FLAGS += -@
ifeq ($(CONFIG_ARCH_CANOE), y)
dtbo-y += canoe-fingerprint.dtbo
endif

ifeq ($(CONFIG_ARCH_SUN), y)
dtbo-y += sun-fingerprint.dtbo
endif

always-y	:= $(dtb-y) $(dtbo-y)
subdir-y	:= $(dts-dirs)
clean-files	:= *.dtb *.dtbo
